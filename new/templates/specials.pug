extends layout.pug

block content
  main#main
    .menu-masthead
      .section-wrap
        h1 Specials
    section.specials-section
      .section-wrap.specials-layout
        div.specials-intro
          img(src='assets/images/5.jpg' alt='A Point After drink garnished with orange and cranberries' width='430' height='600')
        div.specials-list
          .special-row
            h3 Every day
            p $1 mystery shots
          .special-row
            h3 Tuesday
            p 3–5pm happy hour: half off drinks, excluding shots, pitchers and bottles of wine.
          .special-row
            h3 Wednesday
            p PA Day: half off drinks when wearing Point After gear.
          .special-row
            h3 Thursday
            p $5 mules
          .special-row
            h3 Friday
            p 3–5pm old fashioned: $3.50 single, $6 double.